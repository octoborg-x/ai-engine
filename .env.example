# OpenRouter (primary provider)
OPENROUTER_API_KEY=your_key
# Required: yes, unless OPENAI_API_KEY is set (OpenRouter is preferred).
# Source: app/llm/client.py:47, app/rag/embeddings.py

# Keep this set to your current working model.
MODEL_NAME=your_existing_free_model
# Required: yes (fallback model for every routing tier).
# Source: app/llm/router.py:26

# Optional routing tiers. Use OpenRouter models with :free variants.
# MODEL_NAME is also exposed as the selectable "main" model.
MODEL_CHEAP=your_free_cheap_model
# Required: no (falls back to MODEL_NAME).
# Source: app/llm/router.py:21 (dynamic MODEL_{TIER})

MODEL_BALANCED=your_free_balanced_model
# Required: no (falls back to MODEL_NAME).
# Source: app/llm/router.py:21 (dynamic MODEL_{TIER})

MODEL_POWERFUL=your_free_powerful_model
# Required: no (falls back to MODEL_NAME).
# Source: app/llm/router.py:21 (dynamic MODEL_{TIER})

API_AUTH_TOKEN=
# Required: yes for POST /chat and POST /ask (those routes return 401 without it).
# Source: app/security/auth.py:11

RATE_LIMIT_REQUESTS=
# Required: no (defaults to 10).
# Source: app/security/rate_limit.py:44

RATE_LIMIT_WINDOW_SECONDS=
# Required: no (defaults to 60).
# Source: app/security/rate_limit.py:45

OPENAI_API_KEY=
# Required: no. Powers both the OpenAI fallback provider AND the separately
# selectable "openai-compatible" tier in the console. That tier works
# alongside OpenRouter: it always resolves via OPENAI_API_KEY +
# OPENAI_BASE_URL + OPENAI_MODEL, independent of the active provider, and the
# key is only ever sent to OPENAI_BASE_URL.
# Source: app/rag/embeddings.py, app/llm/providers.py:generic_provider

OPENAI_BASE_URL=
# Required: no (defaults to https://api.openai.com/v1; overrides the OpenAI
# endpoint only — has no effect on the OpenRouter or Gemini keys).
# Source: app/llm/providers.py

OPENAI_MODEL=
# Required: no (chat model for the OpenAI-compatible tier and OpenAI fallback
# provider; defaults to MODEL_NAME, then gpt-4o-mini). This is a chat model,
# not embeddings.
# Source: app/llm/providers.py

OPENAI_EMBEDDING_MODEL=
# Required: no. When OPENAI_API_KEY is set, RAG retrieval uses this provider
# for embeddings (OpenRouter free keys cannot call /embeddings, Gemini/OpenAI
# keys can). Defaults to gemini-embedding-001 for Gemini endpoints, else
# text-embedding-3-small for the OpenAI provider.
# Source: app/llm/providers.py, app/rag/embeddings.py

OPENROUTER_BASE_URL=
# Required: no (defaults to https://openrouter.ai/api/v1). Scoped to the
# OpenRouter key — it has no effect on OPENAI_API_KEY or GEMINI_API_KEY.
# Source: app/llm/providers.py

OPENROUTER_MODEL=
# Required: no (fallback chat model for the OpenRouter provider; defaults to
# MODEL_NAME, then gpt-4o-mini).
# Source: app/llm/providers.py

OPENROUTER_EMBEDDING_MODEL=
# Required: no (defaults to openai/text-embedding-3-small for OpenRouter).
# Source: app/llm/providers.py

GEMINI_BASE_URL=
# Required: no (defaults to https://generativelanguage.googleapis.com/v1beta/openai).
# Scoped to the Gemini key — has no effect on the OpenRouter/OpenAI keys.
# Source: app/llm/providers.py

GEMINI_MODEL=
# Required: no (fallback chat model for the Gemini provider; defaults to
# MODEL_NAME, then gpt-4o-mini).
# Source: app/llm/providers.py

GEMINI_EMBEDDING_MODEL=
# Required: no (defaults to text-embedding-004 for Gemini).
# Source: app/llm/providers.py

LLM_BASE_URL=
# Required: no (legacy generic alias — mapped to the Gemini provider's base URL.
# Only meaningful when GEMINI_API_KEY / LLM_API_KEY is the active provider).
# Source: app/llm/providers.py

LLM_API_KEY=
# Required: no (legacy generic alias — treated as the Gemini key when
# GEMINI_API_KEY is unset).
# Source: app/llm/providers.py

EMBEDDINGS_OFFLINE=0
# Required: no (set to 1 to force deterministic zero-vector embeddings and
# skip remote embedding calls in tests or offline demos).
# Source: app/rag/embeddings.py

CORPUS_DIR=
# Required: no (defaults to corpus/source_docs). The Knowledge Assistant
# loads every .md/.txt file in this directory as its RAG knowledge base —
# dropping a readable markdown/text file here and restarting is the
# "upload". PDF/DOCX are intentionally not parsed.

UPLOAD_DIR=
# Required: no (defaults to corpus/uploads). Documents uploaded through the
# console Knowledge tab land here, are merged into the retrieval index, and
# survive restarts. Same supported formats as CORPUS_DIR (.md/.markdown/.txt).
# Source: app/rag/corpus_loader.py

BACKEND_URL=
# Required: no (web proxy defaults to http://localhost:8000).
# Source: web/next.config.ts:3

# Generic provider config (see .env.providers.example)
PROVIDER=openrouter
PROVIDER_MODEL=<free-model>
PROVIDER_KEY_OPENROUTER=<key>
PROVIDER_URL_OPENROUTER=https://openrouter.ai/api/v1
PROVIDER_GEMINI_APIKEY_2=<gemini-key>
PROVIDER_MODEL_GEMINI=<gemini-model>
PROVIDER_URL_GEMINI=https://generativelanguage.googleapis.com/v1beta
PROVIDER_GROQ_APIKEY=<groq-key>
PROVIDER_MODEL_GROQ=<groq-model>
PROVIDER_URL_GROQ=https://api.groq.com/openai/v1
PROVIDER_HUGGINGFACE_APIKEY=<hf-key>
PROVIDER_MODEL_HUGGINGFACE=<hf-model>
PROVIDER_URL_HUGGINGFACE=https://api-inference.huggingface.co
