# OpenRouter (primary provider)
OPENROUTER_API_KEY=your_key
# Required: yes, unless OPENAI_API_KEY is set (OpenRouter is preferred).
# Source: app/llm/client.py:47, app/rag/embeddings.py

# Keep this set to your current working model.
MODEL_NAME=your_existing_free_model
# Required: yes (fallback model for every routing tier).
# Source: app/llm/router.py:26

# Optional routing tiers. Use OpenRouter models with :free variants.
MODEL_CHEAP=your_free_cheap_model
# Required: no (falls back to MODEL_NAME).
# Source: app/llm/router.py:21 (dynamic MODEL_{TIER})

MODEL_BALANCED=your_free_balanced_model
# Required: no (falls back to MODEL_NAME).
# Source: app/llm/router.py:21 (dynamic MODEL_{TIER})

MODEL_POWERFUL=your_free_powerful_model
# Required: no (falls back to MODEL_NAME).
# Source: app/llm/router.py:21 (dynamic MODEL_{TIER})

API_AUTH_TOKEN=
# Required: yes for POST /chat and POST /ask (those routes return 401 without it).
# Source: app/security/auth.py:11

RATE_LIMIT_REQUESTS=
# Required: no (defaults to 10).
# Source: app/security/rate_limit.py:44

RATE_LIMIT_WINDOW_SECONDS=
# Required: no (defaults to 60).
# Source: app/security/rate_limit.py:45

OPENAI_API_KEY=
# Required: no (used only as a fallback when OPENROUTER_API_KEY is unset).
# Source: app/llm/client.py, app/rag/embeddings.py

OPENAI_MODEL=text-embedding-3-small
# Required: no (defaults to text-embedding-3-small; used as the embedding
# model for the OpenAI-compatible fallback provider).
# Source: app/rag/embeddings.py

OPENROUTER_EMBEDDING_MODEL=
# Required: no (defaults to openai/text-embedding-3-small for OpenRouter).
# Source: app/rag/embeddings.py

OPENAI_EMBEDDING_MODEL=
# Required: no (defaults to OPENAI_MODEL / text-embedding-3-small).
# Source: app/rag/embeddings.py

OPENAI_BASE_URL=
# Required: no (defaults to https://api.openai.com/v1; any OpenAI-compatible
# endpoint works, e.g. Gemini's https://generativelanguage.googleapis.com/v1beta/openai/).
# Source: app/llm/client.py, app/rag/embeddings.py

OPENROUTER_BASE_URL=
# Required: no (defaults to https://openrouter.ai/api/v1).
# Source: app/llm/client.py, app/rag/embeddings.py

LLM_BASE_URL=
# Required: no (overrides the provider base URL chosen above).
# Source: app/llm/client.py

EMBEDDINGS_OFFLINE=0
# Required: no (set to 1 to force deterministic zero-vector embeddings and
# skip remote embedding calls in tests or offline demos).
# Source: app/rag/embeddings.py

BACKEND_URL=
# Required: no (web proxy defaults to http://localhost:8000).
# Source: web/next.config.ts:3

# Generic provider config (see .env.providers.example)
PROVIDER=openrouter
PROVIDER_MODEL=<free-model>
PROVIDER_KEY_OPENROUTER=<key>
PROVIDER_URL_OPENROUTER=https://openrouter.ai/api/v1
PROVIDER_GEMINI_APIKEY_2=<gemini-key>
PROVIDER_MODEL_GEMINI=<gemini-model>
PROVIDER_URL_GEMINI=https://generativelanguage.googleapis.com/v1beta
PROVIDER_GROQ_APIKEY=<groq-key>
PROVIDER_MODEL_GROQ=<groq-model>
PROVIDER_URL_GROQ=https://api.groq.com/openai/v1
PROVIDER_HUGGINGFACE_APIKEY=<hf-key>
PROVIDER_MODEL_HUGGINGFACE=<hf-model>
PROVIDER_URL_HUGGINGFACE=https://api-inference.huggingface.co
