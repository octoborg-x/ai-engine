# Generic environment variables — copy to .env or .env.providers
# Provider-agnostic: set PROVIDER + corresponding PROVIDER_* keys

API_AUTH_TOKEN=<secret-key>
BACKEND_URL=<value>
EVAL_BASE_URL=<value>
GEMINI_APIKEY=<secret-key>
GEMINI_APIKEY_2=<secret-key>
GROQ_API_KEY=<secret-key>
HUGGINGFACE_APIKEY=<secret-key>
HUGGING_MODEL=<value>
JUDGE_MODEL=<value>
MODEL_BALANCED=<value>
MODEL_CHEAP=<value>
MODEL_NAME=<value>
MODEL_POWERFUL=<value>
OPENAI_API_KEY=<secret-key>
OPENAI_BASE_URL=<value>
OPENROUTER_API_KEY=<secret-key>
OPENROUTER_BASE_URL=<value>
PROVIDER=<hidden>
PROVIDER_GEMINI_APIKEY_2=<secret-key>
PROVIDER_GROQ_APIKEY=<secret-key>
PROVIDER_HUGGINGFACE_APIKEY=<secret-key>
PROVIDER_KEY_OPENROUTER=<hidden>
PROVIDER_MODEL=<value>
PROVIDER_MODEL_GEMINI=<value>
PROVIDER_MODEL_GROQ=<value>
PROVIDER_MODEL_HUGGINGFACE=<value>
PROVIDER_URL_GEMINI=<value>
PROVIDER_URL_GROQ=<value>
PROVIDER_URL_HUGGINGFACE=<value>
PROVIDER_URL_OPENROUTER=<value>
RATE_LIMIT_REQUESTS=<hidden>
RATE_LIMIT_WINDOW_SECONDS=<hidden>
