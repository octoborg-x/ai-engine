# OpenRouter
# Keep this set to your current working model.
MODEL_NAME=inclusionai/ling-3.0-flash-fin:free

#JUDGE_MODEL=gemini-1.5-flash-latest

# Optional routing tiers. Use OpenRouter models with :free variants.
MODEL_CHEAP=
MODEL_BALANCED=
MODEL_POWERFUL=

API_AUTH_TOKEN=
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
OPENAI_API_KEY=
OPENAI_BASE_URL=
BACKEND_URL=127.0.0.1:8080


#JUDGE_MODEL=mixtral-8x7b-32768

HUGGING_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# Load provider config
# PROVIDER=openrouter
# See .env.providers for per-provider keys/models
