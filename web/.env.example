# Server-side proxy configuration for the Next.js console.
# These are read at request time by app/api/backend/[...path]/route.ts and are
# never exposed to the browser.

# Upstream backend origin that /api/backend/* is proxied to.
# - Local development: http://localhost:8000
# - Docker Compose:    http://backend:8000
BACKEND_URL=http://localhost:8000

# Shared bearer token the proxy attaches before calling the backend. Must match
# the backend's API_AUTH_TOKEN. Keep this out of version control.
API_AUTH_TOKEN=
